# Copy this file to `.env` (gitignored) and fill in real values for the
# environment you're pointing the suite at. `playwright.config.ts` loads
# `.env` automatically via dotenv.

# Base URL of the running idreesia-web instance.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Credentials global-setup.ts logs in with. Defaults in support/constants.ts
# match the fresh-dev-db seed from
# idreesia-web/imports/startup/server/migrations/1-create-admin-user.ts
# (erp-admin / p@ssw0rd) - override here for any environment where that
# password has since been changed, or to use a different account entirely.
E2E_ADMIN_USERNAME=erp-admin
E2E_ADMIN_PASSWORD=p@ssw0rd
