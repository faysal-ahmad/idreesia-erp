# Environment variables to set on the idreesia-mobile component in
# DigitalOcean App Platform (runtime scope). See Dockerfile.production.

# Public URL of this mobile server (must match MOBILE_SERVER_URL used when
# building the installed apps).
ROOT_URL=https://mobile.idreesia.app

# Meteor settings as a single-line JSON string.
#   backendUrl     public URL of the ERP (idreesia-web)
#   rocketChatUrl  public URL of the chat (Rocket.Chat) server
METEOR_SETTINGS={"public":{"backendUrl":"https://idreesia.app","rocketChatUrl":"https://rocketchat.idreesia.app"}}

# Meteor's accounts packages expect one even though the app has no database
# of its own. Any valid-looking URL works; no connection is made to it.
MONGO_URL=mongodb://localhost:27017/idreesia-mobile

# Port the server listens on (Dockerfile exposes 3000).
PORT=3000
