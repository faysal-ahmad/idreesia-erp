# Copy to idreesia-web/.env and fill in. That file is gitignored; this one is
# the tracked template. docker-compose.yml loads it into the idreesia-web
# service via `env_file`, so these values are what the container runs with.

# Host is the compose service name `mongo`, not localhost, because this is read
# from inside the container.
#
# directConnection=true is required: the mongodb-atlas-local image initialises a
# single-node replica set (mongot, and therefore $vectorSearch, needs one).
# Without it the driver attempts replica-set discovery and tries to reach the
# member under the hostname the set advertises for itself, which does not
# resolve from another container.
MONGO_URL=mongodb://mongo:27017/idreesia-erp?directConnection=true

# Outbound mail. Leave blank to disable sending.
MAIL_URL=

# Runs the agenda job processor in this process. Jobs and the web server can be
# split across separate containers by toggling this and WEB_SERVER_ENABLED.
JOBS_ENABLED=true

# Serves the web app from this process. Only set it to false for a
# jobs-only container; anything else leaves you with no HTTP server.
WEB_SERVER_ENABLED=true

# S3-compatible object storage for uploaded files and images. Locally this is
# the `rustfs` compose service; in production, DigitalOcean Spaces
# (S3_ENDPOINT=https://<region>.digitaloceanspaces.com, S3_REGION=<region>,
# S3_FORCE_PATH_STYLE=false, and S3_PUBLIC_ENDPOINT left blank).
S3_ENDPOINT=http://rustfs:9000
# Host the browser uses to open presigned file URLs. The server reaches RustFS
# as `rustfs`, which doesn't resolve outside Docker, so the browser needs
# localhost instead. Leave blank to use S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=idreesia-files
S3_ACCESS_KEY_ID=rustfs_root_user
S3_SECRET_ACCESS_KEY=rustfs_root_user_password
# RustFS only supports path-style addressing.
S3_FORCE_PATH_STYLE=true
