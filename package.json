{
  "name": "idreesia-apps-suite",
  "version": "1.1.1",
  "private": true,
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@apollo/client": "4.2.7",
    "@apollo/server": "^5.5.1",
    "@babel/core": "^7",
    "@babel/eslint-parser": "^7",
    "@babel/plugin-syntax-jsx": "^7",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/cors": "^2.8.19",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/numeral": "^2.0.5",
    "@types/qs": "^6.15.1",
    "@types/react": "17",
    "@types/react-dom": "17",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/request": "^2.48.13",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "antd": "^6.5.2",
    "csvtojson": "^2.0.14",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-meteor": "^7.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "googleapis": "^173.0.0",
    "graphql": "16.14.2",
    "graphql-scalars": "^1.25.0",
    "graphql-tag": "2.10.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "prop-types": "15.8.1",
    "query-string": "7.1.3",
    "react-barcode": "^1.6.1",
    "react-redux": "8.0.5",
    "react-router": "5.1.2",
    "react-to-print": "^3.3.0",
    "redux": "4.2.0",
    "regenerator-runtime": "^0.14.1",
    "request": "^2.88.2",
    "rxjs": "7.8.2",
    "simpl-schema": "3.2.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "compose": "docker compose --file 'docker-compose.yml'",
    "docker:up": "yarn compose up -d",
    "docker:down": "yarn compose down",
    "lint": "eslint \"idreesia-common/**/*.{js,jsx,ts,tsx}\" \"idreesia-web/{client,imports,server}/**/*.{js,jsx,ts,tsx}\" \"idreesia-mobile/{client,imports,server}/**/*.{js,jsx,ts,tsx}\" \"types/**/*.d.ts\" \"*.config.{js,ts}\"",
    "lint:fix": "yarn lint --fix",
    "typecheck": "yarn typecheck:common && yarn typecheck:web && yarn typecheck:mobile",
    "typecheck:common": "tsc --noEmit --project idreesia-common/tsconfig.json",
    "typecheck:web": "tsc --noEmit --project idreesia-web/tsconfig.json",
    "typecheck:mobile": "tsc --noEmit --project idreesia-mobile/tsconfig.json",
    "codegen": "yarn codegen:schema && graphql-codegen --config codegen.ts",
    "codegen:schema": "node scripts/extract-graphql-schema.mjs",
    "release:resolve": "node scripts/resolve-release-version.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint",
      "git add"
    ],
    "*.d.ts": [
      "prettier --write",
      "eslint --fix",
      "eslint",
      "git add"
    ]
  },
  "resolutions": {
    "@babel/core": "^7.29.6",
    "@eslint/plugin-kit": "^0.3.4",
    "ajv": "^6.14.0",
    "flatted": "^3.4.2",
    "js-yaml": "^4.3.0",
    "picomatch": "^2.3.2",
    "yaml": "^2.8.3"
  }
}
