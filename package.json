{
  "name": "idreesia-apps-suite",
  "version": "1.0.2",
  "private": true,
  "devDependencies": {
    "@babel/core": "^7",
    "@babel/eslint-parser": "^7",
    "@babel/plugin-syntax-jsx": "^7",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-meteor": "^7.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "regenerator-runtime": "^0.14.1"
  },
  "scripts": {
    "compose": "docker compose --file 'docker-compose.yml'",
    "docker:up": "yarn compose up -d",
    "docker:down": "yarn compose down",
    "lint": "eslint \"idreesia-common/**/*.{js,jsx}\" \"idreesia-web/{client,imports,server}/**/*.{js,jsx}\"",
    "lint:fix": "yarn lint --fix",
    "release:resolve": "node scripts/resolve-release-version.mjs"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint",
      "git add"
    ]
  },
  "resolutions": {
    "@babel/core": "^7.29.6",
    "@eslint/plugin-kit": "^0.3.4",
    "ajv": "^6.14.0",
    "brace-expansion": "^1.1.16",
    "flatted": "^3.4.2",
    "js-yaml": "^4.3.0",
    "minimatch": "^3.1.4",
    "picomatch": "^2.3.2",
    "yaml": "^2.8.3"
  }
}
