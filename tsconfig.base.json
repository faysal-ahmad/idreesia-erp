{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "react", "react-dom"],
    "paths": {
      "/imports/*": ["idreesia-web/imports/*"],
      "/client/*": ["idreesia-web/client/*"],
      "/server/*": ["idreesia-web/server/*"],
      "meteor/idreesia-common/*": ["idreesia-common/*"]
    }
  }
}
